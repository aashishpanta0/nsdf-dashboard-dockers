FROM ubuntu:24.04

ARG OPENVISUSPY_REF=test_region_extraction

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/openvisuspy/src \
    PATH=/opt/venv/bin:$PATH \
    BOKEH_ALLOW_WS_ORIGIN=* \
    VISUS_CACHE=/var/cache/visus

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates git python3 python3-venv \
        libgl1 libglu1-mesa libglib2.0-0t64 libgomp1 libxrender1 libxext6 libsm6 \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv

RUN git clone --depth 1 --branch "${OPENVISUSPY_REF}" \
        https://github.com/sci-visus/openvisuspy.git /opt/openvisuspy \
    && rm -rf /opt/openvisuspy/.git \
    && python -m pip install --no-cache-dir --only-binary=OpenVisus \
        bokeh panel ipywidgets OpenVisus ipywidgets_bokeh ipykernel \
        boto3 xmltodict aiohttp colorcet \
    && python -c "import OpenVisus; import openvisuspy"

RUN useradd --create-home --uid 10001 dashboard \
    && mkdir -p /var/cache/visus /data \
    && chown dashboard:dashboard /var/cache/visus /data

WORKDIR /opt/openvisuspy
USER dashboard

EXPOSE 5006

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5006/app', timeout=4)" || exit 1

ENTRYPOINT ["python", "-m", "panel", "serve", "app", "--address", "0.0.0.0", "--port", "5006"]
CMD ["--args", "json/nasa.json"]